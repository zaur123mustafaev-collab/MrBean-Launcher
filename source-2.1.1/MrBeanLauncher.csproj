<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MrBeanLauncher</RootNamespace>
    <AssemblyName>MrBeanLauncher</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <Version>2.1.1</Version>
    <Product>MrBean Launcher</Product>
    <Company>MrBean</Company>
    <Description>MrBean Launcher — Minecraft 1.21.11 + MrBean Visuals</Description>
    <Copyright>MrBean 2026</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\hero.jpg" LogicalName="MrBeanLauncher.Assets.hero.jpg" />
    <EmbeddedResource Include="Assets\bg.jpg" LogicalName="MrBeanLauncher.Assets.bg.jpg" />
    <EmbeddedResource Include="Assets\face.png" LogicalName="MrBeanLauncher.Assets.face.png" />
    <EmbeddedResource Include="Assets\MrBeanVisuals.jar" LogicalName="MrBeanLauncher.Assets.MrBeanVisuals.jar" />
  </ItemGroup>
</Project>
